{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/filing-document.schema.json",
  "title": "Turtle Value Engine Filing Document Cache Manifest",
  "description": "A verified official A-share or H-share filing manifest. The document bytes are stored separately as a content-addressed binary blob.",
  "type": "object",
  "required": [
    "cache_format_version",
    "filing",
    "final_url",
    "retrieved_at",
    "content_sha256",
    "content_size",
    "media_type",
    "retrieval_metadata",
    "blob"
  ],
  "properties": {
    "cache_format_version": {"type": "integer", "const": 1},
    "filing": {"$ref": "#/$defs/filing"},
    "final_url": {"type": "string", "pattern": "^https?://", "format": "uri"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52428800
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9!#$&^_.+\\-]+/[a-z0-9!#$&^_.+\\-]+$"
    },
    "retrieval_metadata": {
      "type": "object",
      "required": [
        "contract",
        "filing_id",
        "listing_id",
        "market",
        "source",
        "requested_url",
        "final_url",
        "content_sha256",
        "content_size",
        "media_type"
      ],
      "properties": {
        "contract": {"const": "filing_document_v1"},
        "filing_id": {"type": "string", "pattern": "^filing-[0-9a-f]{24}$"},
        "listing_id": {
          "type": "string",
          "pattern": "^(?:(?:SH|SZ|BJ)[0-9]{6}|HK[0-9]{5})$"
        },
        "market": {"type": "string", "enum": ["A", "H"]},
        "source": {
          "type": "string",
          "enum": [
            "CNINFO",
            "SSE",
            "SZSE",
            "BSE",
            "A_COMPANY_ANNOUNCEMENT",
            "HKEXNEWS",
            "H_COMPANY_REPORT",
            "H_COMPANY_ANNOUNCEMENT"
          ]
        },
        "requested_url": {"type": "string", "pattern": "^https?://", "format": "uri"},
        "final_url": {"type": "string", "pattern": "^https?://", "format": "uri"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_size": {"type": "integer", "minimum": 1, "maximum": 52428800},
        "media_type": {"type": "string"}
      },
      "additionalProperties": true
    },
    "blob": {
      "type": "string",
      "pattern": "^filing-[0-9a-f]{24}\\.[0-9a-f]{64}\\.bin$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"filing": {"properties": {"market": {"const": "A"}}}}},
      "then": {
        "properties": {
          "filing": {
            "properties": {
              "source": {
                "enum": [
                  "CNINFO",
                  "SSE",
                  "SZSE",
                  "BSE",
                  "A_COMPANY_ANNOUNCEMENT"
                ]
              }
            }
          },
          "retrieval_metadata": {
            "properties": {
              "source": {
                "enum": [
                  "CNINFO",
                  "SSE",
                  "SZSE",
                  "BSE",
                  "A_COMPANY_ANNOUNCEMENT"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"filing": {"properties": {"market": {"const": "H"}}}}},
      "then": {
        "properties": {
          "filing": {
            "properties": {
              "source": {
                "enum": ["HKEXNEWS", "H_COMPANY_REPORT", "H_COMPANY_ANNOUNCEMENT"]
              }
            }
          },
          "retrieval_metadata": {
            "properties": {
              "source": {
                "enum": ["HKEXNEWS", "H_COMPANY_REPORT", "H_COMPANY_ANNOUNCEMENT"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "filing": {
      "type": "object",
      "required": [
        "filing_id",
        "listing_id",
        "market",
        "source",
        "title",
        "document_type",
        "published_date",
        "url"
      ],
      "properties": {
        "filing_id": {"type": "string", "pattern": "^filing-[0-9a-f]{24}$"},
        "listing_id": {
          "type": "string",
          "pattern": "^(?:(?:SH|SZ|BJ)[0-9]{6}|HK[0-9]{5})$"
        },
        "market": {"type": "string", "enum": ["A", "H"]},
        "source": {
          "type": "string",
          "enum": [
            "CNINFO",
            "SSE",
            "SZSE",
            "BSE",
            "A_COMPANY_ANNOUNCEMENT",
            "HKEXNEWS",
            "H_COMPANY_REPORT",
            "H_COMPANY_ANNOUNCEMENT"
          ]
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "document_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "published_date": {"type": "string", "format": "date"},
        "url": {"type": "string", "pattern": "^https?://", "format": "uri"},
        "source_document_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "report_period": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "issuer_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
