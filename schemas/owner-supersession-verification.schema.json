          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "KEY_IDENTITY_BINDING"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "KEY_VALIDITY_WINDOW"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
