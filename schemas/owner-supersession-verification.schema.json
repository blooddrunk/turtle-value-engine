      "maxLength": 128,
      "minLength": 1,
      "title": "Superseded Record Id",
      "type": "string"
    },
    "superseding_record_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Superseding Record Id",
      "type": "string"
    },
