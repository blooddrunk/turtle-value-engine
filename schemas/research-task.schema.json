{
  "$defs": {
    "Adjustment": {
      "additionalProperties": false,
      "description": "Explicit economic adjustment with proposal/approval provenance.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target_field": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target Field",
          "type": "string"
        },
        "target_period": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Period"
        },
        "adjustment_type": {
          "$ref": "#/$defs/AdjustmentType"
        },
        "input_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Value"
        },
        "proposed_adjusted_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Adjusted Value"
        },
        "status": {
          "$ref": "#/$defs/AdjustmentStatus"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "proposed_by": {
          "$ref": "#/$defs/ProposedBy"
        },
        "approved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovedBy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "id",
        "target_field",
        "adjustment_type",
        "status",
        "reason",
        "source_evidence_ids",
        "proposed_by"
      ],
      "title": "Adjustment",
      "type": "object"
    },
    "AdjustmentStatus": {
      "description": "Lifecycle state of an adjustment proposal.",
      "enum": [
        "PROPOSED",
        "ACCEPTED",
        "REJECTED"
      ],
      "title": "AdjustmentStatus",
      "type": "string"
    },
    "AdjustmentType": {
      "description": "Adjustment types permitted by the data contract.",
      "enum": [
        "RECLASSIFY",
        "EXCLUDE",
        "INCLUDE",
        "HAIRCUT",
        "OWNERSHIP_ADJUST",
        "UPSTREAMABILITY_ADJUST",
        "NORMALIZE",
        "OTHER"
      ],
      "title": "AdjustmentType",
      "type": "string"
    },
    "AnalystRole": {
      "description": "Stable role names understood by external agent runtimes.",
      "enum": [
        "RESEARCH",
        "QUALITY_ANALYST",
        "SKEPTIC",
        "ADJUDICATOR",
        "REPORT_COMPOSER"
      ],
      "title": "AnalystRole",
      "type": "string"
    },
    "ApprovedBy": {
      "description": "Actor that approved an adjustment.",
      "enum": [
        "RULE_ENGINE",
        "HUMAN"
      ],
      "title": "ApprovedBy",
      "type": "string"
    },
    "ConfidenceLevel": {
      "description": "Qualitative confidence used by metrics, gates and decisions.",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "CounterEvidenceClaim": {
      "additionalProperties": false,
      "description": "A falsifying/counter claim whose evidence must be in the task packet.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "direction": {
          "const": "COUNTER",
          "default": "COUNTER",
          "title": "Direction",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "deterministic_metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Deterministic Metric Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "statement",
        "evidence_ids",
        "confidence"
      ],
      "title": "CounterEvidenceClaim",
      "type": "object"
    },
    "DeterministicMetric": {
      "additionalProperties": false,
      "description": "A read-only metric already produced by deterministic engine code.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "calculation_contract": {
          "const": "DETERMINISTIC_ENGINE",
          "default": "DETERMINISTIC_ENGINE",
          "title": "Calculation Contract",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "DeterministicMetric",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Auditable evidence item used by facts, adjustments and judgments.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/EvidenceDirection"
        },
        "strength": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "metric_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "direction",
        "strength",
        "statement",
        "source",
        "confidence"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "description": "A supporting claim whose evidence must be in the task packet.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "direction": {
          "const": "SUPPORT",
          "default": "SUPPORT",
          "title": "Direction",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "deterministic_metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Deterministic Metric Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "statement",
        "evidence_ids",
        "confidence"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "EvidenceDirection": {
      "description": "Whether evidence supports, challenges or contextualizes a claim.",
      "enum": [
        "SUPPORT",
        "COUNTER",
        "CONTEXT"
      ],
      "title": "EvidenceDirection",
      "type": "string"
    },
    "EvidencePacket": {
      "additionalProperties": false,
      "description": "The complete bounded input made available to one analyst task.",
      "properties": {
        "contract": {
          "const": "evidence_packet_v1",
          "default": "evidence_packet_v1",
          "title": "Contract",
          "type": "string"
        },
        "packet_id": {
          "minLength": 1,
          "title": "Packet Id",
          "type": "string"
        },
        "analysis_id": {
          "minLength": 1,
          "title": "Analysis Id",
          "type": "string"
        },
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AnalystRole"
        },
        "question": {
          "$ref": "#/$defs/ResearchQuestion"
        },
        "intent": {
          "$ref": "#/$defs/ResearchIntent"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 128,
          "title": "Evidence",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/PacketFact"
          },
          "maxItems": 256,
          "title": "Facts",
          "type": "array"
        },
        "deterministic_metrics": {
          "items": {
            "$ref": "#/$defs/DeterministicMetric"
          },
          "maxItems": 128,
          "title": "Deterministic Metrics",
          "type": "array"
        },
        "available_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Available Evidence Ids",
          "type": "array"
        },
        "available_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Available Fact Ids",
          "type": "array"
        },
        "undated_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Undated Evidence Ids",
          "type": "array"
        },
        "undated_evidence_policy": {
          "$ref": "#/$defs/UndatedEvidencePolicy",
          "default": "REJECT"
        },
        "undated_evidence_attestation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Undated Evidence Attestation"
        },
        "protocol_version": {
          "default": "research-protocol-v1",
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "packet_id",
        "analysis_id",
        "listing_id",
        "as_of",
        "profile_id",
        "role",
        "question",
        "intent",
        "evidence",
        "facts",
        "deterministic_metrics",
        "content_sha256"
      ],
      "title": "EvidencePacket",
      "type": "object"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "description": "Exact filing-extraction identity behind one evidence item.\n\nThe provider layer uses this additive metadata to bind an evidence item\nto one immutable document snapshot and one extracted text block.  It is\ndeliberately separate from ``Source`` so existing structured-data\nevidence keeps its original shape while filing evidence can carry the\nstronger byte- and parser-level provenance required for replay.",
      "properties": {
        "filing_id": {
          "minLength": 1,
          "pattern": "^filing-[0-9a-f]{24}$",
          "title": "Filing Id",
          "type": "string"
        },
        "filing_source": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Filing Source",
          "type": "string"
        },
        "source_document_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Document Id"
        },
        "report_period": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Period"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "content_size": {
          "minimum": 1,
          "title": "Content Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "extraction_contract": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Extraction Contract",
          "type": "string"
        },
        "parser_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parser Id",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "block_sequence": {
          "minimum": 1,
          "title": "Block Sequence",
          "type": "integer"
        },
        "block_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Block Sha256",
          "type": "string"
        }
      },
      "required": [
        "filing_id",
        "filing_source",
        "content_sha256",
        "content_size",
        "media_type",
        "extraction_contract",
        "parser_id",
        "parser_version",
        "block_sequence",
        "block_sha256"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    },
    "EvidenceStrength": {
      "description": "Evidence quality level defined by the repository specification.",
      "enum": [
        "E3",
        "E2",
        "E1",
        "E0"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "MetricContext": {
      "additionalProperties": false,
      "description": "Optional metric context attached to evidence.",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        }
      },
      "required": [
        "metric"
      ],
      "title": "MetricContext",
      "type": "object"
    },
    "PacketFact": {
      "additionalProperties": false,
      "description": "A source fact exposed to an analyst without presenting it as a metric.",
      "properties": {
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "period": {
          "minLength": 1,
          "title": "Period",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "origin": {
          "default": "NORMALIZED_SOURCE_FACT",
          "enum": [
            "NORMALIZED_SOURCE_FACT",
            "EFFECTIVE_INPUT_FACT"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_fact_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Fact Id"
        },
        "applied_adjustment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Applied Adjustment Ids",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "field",
        "value",
        "period",
        "source_evidence_ids",
        "confidence"
      ],
      "title": "PacketFact",
      "type": "object"
    },
    "ProposedBy": {
      "description": "Actor that proposed an adjustment.",
      "enum": [
        "RULE_ENGINE",
        "LLM",
        "HUMAN"
      ],
      "title": "ProposedBy",
      "type": "string"
    },
    "ResearchFinding": {
      "additionalProperties": false,
      "description": "One analyst's structured, untrusted research finding.",
      "properties": {
        "contract": {
          "const": "research_finding_v1",
          "default": "research_finding_v1",
          "title": "Contract",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "analysis_id": {
          "minLength": 1,
          "title": "Analysis Id",
          "type": "string"
        },
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AnalystRole"
        },
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "dimension": {
          "anyOf": [
            {
              "enum": [
                "demand_durability",
                "cyclicality",
                "pricing_power",
                "moat",
                "capital_efficiency",
                "dependency",
                "regulatory_risk",
                "predictability"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension"
        },
        "summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "supporting_claims": {
          "items": {
            "$ref": "#/$defs/EvidenceClaim"
          },
          "maxItems": 64,
          "title": "Supporting Claims",
          "type": "array"
        },
        "counter_evidence_claims": {
          "items": {
            "$ref": "#/$defs/CounterEvidenceClaim"
          },
          "maxItems": 64,
          "title": "Counter Evidence Claims",
          "type": "array"
        },
        "proposed_score": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Score"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "deterministic_metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Deterministic Metric Ids",
          "type": "array"
        },
        "unresolved_questions": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Unresolved Questions",
          "type": "array"
        },
        "counter_evidence_checked": {
          "default": false,
          "title": "Counter Evidence Checked",
          "type": "boolean"
        },
        "proposed_adjustments": {
          "items": {
            "$ref": "#/$defs/Adjustment"
          },
          "maxItems": 32,
          "title": "Proposed Adjustments",
          "type": "array"
        }
      },
      "required": [
        "contract",
        "id",
        "analysis_id",
        "listing_id",
        "as_of",
        "role",
        "question_id",
        "summary",
        "confidence"
      ],
      "title": "ResearchFinding",
      "type": "object"
    },
    "ResearchIntent": {
      "description": "The bounded purpose of one research packet.",
      "enum": [
        "THESIS",
        "FALSIFICATION",
        "ADJUDICATION"
      ],
      "title": "ResearchIntent",
      "type": "string"
    },
    "ResearchQuestion": {
      "additionalProperties": false,
      "description": "One exact, bounded research question.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "dimension": {
          "anyOf": [
            {
              "enum": [
                "demand_durability",
                "cyclicality",
                "pricing_power",
                "moat",
                "capital_efficiency",
                "dependency",
                "regulatory_risk",
                "predictability"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension"
        },
        "intent": {
          "$ref": "#/$defs/ResearchIntent"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "focus_areas": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Focus Areas",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "intent",
        "text"
      ],
      "title": "ResearchQuestion",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Stable provenance locator for an evidence item.",
      "properties": {
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "published_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Date"
        },
        "fiscal_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fiscal Period"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "table_or_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Or Note"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        }
      },
      "required": [
        "type",
        "title"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceType": {
      "description": "Source types permitted by evidence.schema.json.",
      "enum": [
        "ANNUAL_REPORT",
        "INTERIM_REPORT",
        "EXCHANGE_FILING",
        "COMPANY_ANNOUNCEMENT",
        "COMPANY_OPERATING_DISCLOSURE",
        "GOVERNMENT",
        "REGULATOR",
        "INDUSTRY_ASSOCIATION",
        "STRUCTURED_DATA_VENDOR",
        "RESEARCH_PROVIDER",
        "NEWS",
        "OTHER"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "UndatedEvidencePolicy": {
      "description": "Whether a packet may opt into evidence without a publication date.",
      "enum": [
        "REJECT",
        "EXPLICIT_FROZEN"
      ],
      "title": "UndatedEvidencePolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The exact input envelope passed to an injected analyst client.",
  "properties": {
    "contract": {
      "const": "research_task_v1",
      "default": "research_task_v1",
      "title": "Contract",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "listing_id": {
      "minLength": 1,
      "title": "Listing Id",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/AnalystRole"
    },
    "question": {
      "$ref": "#/$defs/ResearchQuestion"
    },
    "packet": {
      "$ref": "#/$defs/EvidencePacket"
    },
    "context_run_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Context Run Ids",
      "type": "array"
    },
    "context_findings": {
      "items": {
        "$ref": "#/$defs/ResearchFinding"
      },
      "maxItems": 32,
      "title": "Context Findings",
      "type": "array"
    },
    "max_output_claims": {
      "default": 64,
      "exclusiveMinimum": 0,
      "maximum": 128,
      "title": "Max Output Claims",
      "type": "integer"
    },
    "max_unresolved_questions": {
      "default": 64,
      "exclusiveMinimum": 0,
      "maximum": 128,
      "title": "Max Unresolved Questions",
      "type": "integer"
    },
    "timeout_seconds": {
      "default": 60.0,
      "exclusiveMinimum": 0,
      "maximum": 3600,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "max_context_items": {
      "default": 256,
      "exclusiveMinimum": 0,
      "maximum": 4096,
      "title": "Max Context Items",
      "type": "integer"
    },
    "max_output_bytes": {
      "default": 100000,
      "exclusiveMinimum": 0,
      "maximum": 10000000,
      "title": "Max Output Bytes",
      "type": "integer"
    },
    "prompt_version": {
      "default": "research-prompt-v1",
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "protocol_version": {
      "default": "research-protocol-v1",
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "task_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "task_id",
    "analysis_id",
    "listing_id",
    "as_of",
    "profile_id",
    "role",
    "question",
    "packet",
    "task_sha256"
  ],
  "title": "Turtle Value Engine research-task",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/research-task.schema.json"
