        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Rollback Exclusions",
      "type": "array"
    },
    "rollback_reference": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Rollback Reference",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
