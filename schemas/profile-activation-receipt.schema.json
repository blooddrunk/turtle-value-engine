    "plan_id",
    "plan_content_sha256",
    "current_profile_id",
    "current_profile_sha256",
    "activated_profile_id",
    "activated_profile_sha256",
    "release_manifest_id",
    "release_manifest_content_sha256",
    "audit_id",
