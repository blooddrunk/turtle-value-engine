{
  "additionalProperties": false,
  "description": "Immutable, deterministic receipt of one completed activation.\n\nBinds the exact fresh plan identity and content, the base/target profile\nbytes, the release manifest, the fresh audit, the active owner decision\nrecord, the strictly loaded evidence bundle, the re-attesting trust-root\nregistry, the exact config bytes replaced (prior and activated hashes),\nthe content-addressed before-image and the rollback reference.  No\nwall-clock field: a resumed or repeated activation of the same\nauthoritative state produces byte-identical bytes.",
  "properties": {
    "activated_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Activated Config Sha256",
      "type": "string"
    },
    "activated_default_profile": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Activated Default Profile",
      "type": "string"
    },
    "activated_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Activated Profile Id",
      "type": "string"
    },
    "activated_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Activated Profile Sha256",
      "type": "string"
    },
    "activation_id": {
      "maxLength": 168,
      "minLength": 1,
      "title": "Activation Id",
      "type": "string"
    },
    "apply_was_explicit_opt_in": {
      "const": true,
      "default": true,
      "title": "Apply Was Explicit Opt In",
      "type": "boolean"
    },
    "audit_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Audit Content Sha256",
      "type": "string"
    },
    "audit_id": {
      "maxLength": 168,
      "minLength": 1,
      "title": "Audit Id",
      "type": "string"
    },
    "authority_registry_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authority Registry Content Sha256",
      "type": "string"
    },
    "authority_registry_id": {
      "maxLength": 168,
      "minLength": 1,
      "title": "Authority Registry Id",
      "type": "string"
    },
    "automatic_rollback_allowed": {
      "const": false,
      "default": false,
      "title": "Automatic Rollback Allowed",
      "type": "boolean"
    },
    "before_image_name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Before Image Name",
      "type": "string"
    },
    "before_image_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Before Image Sha256",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "contract": {
      "const": "profile_activation_receipt_v1",
      "default": "profile_activation_receipt_v1",
      "title": "Contract",
      "type": "string"
    },
    "current_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Current Profile Id",
      "type": "string"
    },
    "current_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Profile Sha256",
      "type": "string"
    },
    "decision_record_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Record Content Sha256",
      "type": "string"
    },
    "decision_record_id": {
      "maxLength": 168,
      "minLength": 1,
      "title": "Decision Record Id",
      "type": "string"
    },
    "evidence_bundle_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Content Sha256",
      "type": "string"
    },
    "evidence_bundle_id": {
      "maxLength": 168,
      "minLength": 1,
      "title": "Evidence Bundle Id",
      "type": "string"
    },
    "outcome": {
      "const": "ACTIVATED",
      "default": "ACTIVATED",
      "title": "Outcome",
      "type": "string"
    },
    "plan_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Content Sha256",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 168,
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "prior_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prior Config Sha256",
      "type": "string"
    },
    "prior_default_profile": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Prior Default Profile",
      "type": "string"
    },
    "project_config_path": {
