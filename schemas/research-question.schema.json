{
  "$defs": {
    "ResearchIntent": {
      "description": "The bounded purpose of one research packet.",
      "enum": [
        "THESIS",
        "FALSIFICATION",
        "ADJUDICATION"
      ],
      "title": "ResearchIntent",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One exact, bounded research question.",
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "dimension": {
      "anyOf": [
        {
          "enum": [
            "demand_durability",
            "cyclicality",
            "pricing_power",
            "moat",
            "capital_efficiency",
            "dependency",
            "regulatory_risk",
            "predictability"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dimension"
    },
    "intent": {
      "$ref": "#/$defs/ResearchIntent"
    },
    "text": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "focus_areas": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Focus Areas",
      "type": "array"
    },
    "required": {
      "default": true,
      "title": "Required",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "intent",
    "text"
  ],
  "title": "Turtle Value Engine research-question",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/research-question.schema.json"
}
