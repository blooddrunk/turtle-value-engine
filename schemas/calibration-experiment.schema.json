{
  "$defs": {
    "CalibrationSearchSpace": {
      "additionalProperties": false,
      "description": "Explicit finite candidate values; no hidden mutation of strict-v1.",
      "properties": {
        "contract": {
          "const": "calibration_search_space_v1",
          "default": "calibration_search_space_v1",
          "title": "Contract",
          "type": "string"
        },
        "space_id": {
          "minLength": 1,
          "title": "Space Id",
          "type": "string"
        },
        "base_profile_id": {
          "minLength": 1,
          "title": "Base Profile Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "array"
          },
          "maxProperties": 64,
          "minProperties": 1,
          "title": "Parameters",
          "type": "object"
        },
        "max_trials": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Trials",
          "type": "integer"
        },
        "objective": {
          "default": "RISK_ADJUSTED",
          "enum": [
            "MEAN_RETURN",
            "MEDIAN_RETURN",
            "HIT_RATE",
            "RISK_ADJUSTED"
          ],
          "title": "Objective",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "space_id",
        "base_profile_id",
        "parameters"
      ],
      "title": "CalibrationSearchSpace",
      "type": "object"
    },
    "CalibrationStage": {
      "enum": [
        "SEARCH",
        "HOLDOUT_EVALUATION"
      ],
      "title": "CalibrationStage",
      "type": "string"
    },
    "CalibrationTrial": {
      "additionalProperties": false,
      "description": "One candidate result; search trials never contain holdout outcomes.",
      "properties": {
        "contract": {
          "const": "calibration_trial_v1",
          "default": "calibration_trial_v1",
          "title": "Contract",
          "type": "string"
        },
        "trial_id": {
          "minLength": 1,
          "title": "Trial Id",
          "type": "string"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "candidate_profile_id": {
          "minLength": 1,
          "title": "Candidate Profile Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "stage": {
          "$ref": "#/$defs/CalibrationStage",
          "default": "SEARCH"
        },
        "train_count": {
          "minimum": 0,
          "title": "Train Count",
          "type": "integer"
        },
        "validation_count": {
          "minimum": 0,
          "title": "Validation Count",
          "type": "integer"
        },
        "holdout_count": {
          "default": 0,
          "minimum": 0,
          "title": "Holdout Count",
          "type": "integer"
        },
        "train_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Score"
        },
        "validation_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Score"
        },
        "holdout_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Score"
        },
        "stability_penalty": {
          "default": 0,
          "title": "Stability Penalty",
          "type": "number"
        },
        "objective_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective Score"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "contract",
        "trial_id",
        "experiment_id",
        "candidate_profile_id",
        "parameters",
        "train_count",
        "validation_count"
      ],
      "title": "CalibrationTrial",
      "type": "object"
    },
    "CandidateProfileProposal": {
      "additionalProperties": false,
      "description": "Calibration output that is a proposal, never an automatic rule change.",
      "properties": {
        "contract": {
          "const": "candidate_profile_proposal_v1",
          "default": "candidate_profile_proposal_v1",
          "title": "Contract",
          "type": "string"
        },
        "proposal_id": {
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "base_profile_id": {
          "minLength": 1,
          "title": "Base Profile Id",
          "type": "string"
        },
        "base_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Profile Sha256",
          "type": "string"
        },
        "candidate_profile_id": {
          "minLength": 1,
          "title": "Candidate Profile Id",
          "type": "string"
        },
        "parameter_overrides": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Parameter Overrides",
          "type": "object"
        },
        "train_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Score"
        },
        "validation_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Score"
        },
        "holdout_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Score"
        },
        "stability_summary": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stability Summary",
          "type": "object"
        },
        "rationale": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "status": {
          "default": "PROPOSAL_ONLY",
          "enum": [
            "PROPOSAL_ONLY",
            "HUMAN_APPROVED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "automatic_application_allowed": {
          "default": false,
          "title": "Automatic Application Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "proposal_id",
        "base_profile_id",
        "base_profile_sha256",
        "candidate_profile_id",
        "parameter_overrides",
        "rationale"
      ],
      "title": "CandidateProfileProposal",
      "type": "object"
    },
    "ChronologicalSplit": {
      "additionalProperties": false,
      "description": "Non-overlapping train/validation/holdout time ranges.",
      "properties": {
        "contract": {
          "const": "chronological_split_v1",
          "default": "chronological_split_v1",
          "title": "Contract",
          "type": "string"
        },
        "train_start": {
          "format": "date",
          "title": "Train Start",
          "type": "string"
        },
        "train_end": {
          "format": "date",
          "title": "Train End",
          "type": "string"
        },
        "validation_start": {
          "format": "date",
          "title": "Validation Start",
          "type": "string"
        },
        "validation_end": {
          "format": "date",
          "title": "Validation End",
          "type": "string"
        },
        "holdout_start": {
          "format": "date",
          "title": "Holdout Start",
          "type": "string"
        },
        "holdout_end": {
          "format": "date",
          "title": "Holdout End",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "train_start",
        "train_end",
        "validation_start",
        "validation_end",
        "holdout_start",
        "holdout_end"
      ],
      "title": "ChronologicalSplit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Chronologically guarded calibration experiment and candidate proposal.",
  "properties": {
    "contract": {
      "const": "calibration_experiment_v1",
      "default": "calibration_experiment_v1",
      "title": "Contract",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "manifest_id": {
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "base_profile_id": {
      "minLength": 1,
      "title": "Base Profile Id",
      "type": "string"
    },
    "base_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Profile Sha256",
      "type": "string"
    },
    "search_space": {
      "$ref": "#/$defs/CalibrationSearchSpace"
    },
    "split": {
      "$ref": "#/$defs/ChronologicalSplit"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/CalibrationTrial"
      },
      "maxItems": 1000000,
      "title": "Trials",
      "type": "array"
    },
    "selected_trial_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Trial Id"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateProfileProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "holdout_locked": {
      "default": true,
      "title": "Holdout Locked",
      "type": "boolean"
    },
    "holdout_observation_ids": {
      "items": {
        "type": "string"
      },
      "title": "Holdout Observation Ids",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "experiment_id",
    "manifest_id",
    "base_profile_id",
    "base_profile_sha256",
    "search_space",
    "split",
    "content_sha256"
  ],
  "title": "Turtle Value Engine calibration-experiment",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/calibration-experiment.schema.json"
}
