{
  "$defs": {
    "CalibrationSearchSpace": {
      "additionalProperties": false,
      "description": "Explicit finite candidate values; no hidden mutation of strict-v1.\n\n``materialization_semantics`` (Phase 7-B1, additive and optional) freezes\na reference to one installed materializable-parameter semantics set at\ncalibration time — before any trial is scored.  Because the search space\nis part of the deterministic experiment identity (and therefore of the\nauthoritative Phase 7-A-R2 freeze), a semantics-bearing space pins the\nparameter -> rule-leaf meaning of its candidates from the start; a\nlegacy/unbound space without the field stays readable and evaluable but\ncan never be materialized into a candidate rule profile.",
      "properties": {
        "base_profile_id": {
          "minLength": 1,
          "title": "Base Profile Id",
          "type": "string"
        },
        "contract": {
          "const": "calibration_search_space_v1",
          "default": "calibration_search_space_v1",
          "title": "Contract",
          "type": "string"
        },
        "materialization_semantics": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterializationSemanticsReferenceV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_trials": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Trials",
          "type": "integer"
        },
        "objective": {
          "default": "RISK_ADJUSTED",
          "enum": [
            "MEAN_RETURN",
            "MEDIAN_RETURN",
            "HIT_RATE",
            "RISK_ADJUSTED"
          ],
          "title": "Objective",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "array"
          },
          "maxProperties": 64,
          "minProperties": 1,
          "title": "Parameters",
          "type": "object"
        },
        "space_id": {
          "minLength": 1,
          "title": "Space Id",
          "type": "string"
        }
      },
      "required": [
        "space_id",
        "base_profile_id",
        "parameters"
      ],
      "title": "CalibrationSearchSpace",
      "type": "object"
    },
    "CalibrationStage": {
      "enum": [
        "SEARCH",
        "HOLDOUT_EVALUATION"
      ],
      "title": "CalibrationStage",
      "type": "string"
    },
    "CalibrationTrial": {
      "additionalProperties": false,
      "description": "One candidate result; search trials never contain holdout outcomes.",
      "properties": {
        "candidate_profile_id": {
          "minLength": 1,
          "title": "Candidate Profile Id",
          "type": "string"
        },
        "contract": {
          "const": "calibration_trial_v1",
          "default": "calibration_trial_v1",
          "title": "Contract",
          "type": "string"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "holdout_count": {
          "default": 0,
          "minimum": 0,
          "title": "Holdout Count",
          "type": "integer"
        },
        "holdout_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Score"
        },
        "objective_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective Score"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "stability_penalty": {
          "default": 0,
          "title": "Stability Penalty",
          "type": "number"
        },
        "stage": {
          "$ref": "#/$defs/CalibrationStage",
          "default": "SEARCH"
        },
        "train_count": {
          "minimum": 0,
          "title": "Train Count",
          "type": "integer"
        },
        "train_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Score"
        },
        "trial_id": {
          "minLength": 1,
          "title": "Trial Id",
          "type": "string"
        },
        "validation_count": {
          "minimum": 0,
          "title": "Validation Count",
          "type": "integer"
        },
        "validation_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Score"
        }
      },
      "required": [
        "trial_id",
        "experiment_id",
        "candidate_profile_id",
        "parameters",
        "train_count",
        "validation_count"
      ],
      "title": "CalibrationTrial",
      "type": "object"
    },
    "CandidateProfileProposal": {
      "additionalProperties": false,
      "description": "Calibration output that is a proposal, never an automatic rule change.",
      "properties": {
        "automatic_application_allowed": {
          "default": false,
          "title": "Automatic Application Allowed",
          "type": "boolean"
        },
        "base_profile_id": {
          "minLength": 1,
          "title": "Base Profile Id",
          "type": "string"
        },
        "base_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Profile Sha256",
          "type": "string"
        },
        "candidate_profile_id": {
          "minLength": 1,
          "title": "Candidate Profile Id",
          "type": "string"
        },
        "contract": {
          "const": "candidate_profile_proposal_v1",
          "default": "candidate_profile_proposal_v1",
          "title": "Contract",
          "type": "string"
        },
        "holdout_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Score"
        },
        "parameter_overrides": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Parameter Overrides",
          "type": "object"
        },
        "proposal_id": {
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "stability_summary": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stability Summary",
          "type": "object"
        },
        "status": {
          "default": "PROPOSAL_ONLY",
          "enum": [
            "PROPOSAL_ONLY",
            "HUMAN_APPROVED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "train_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Score"
        },
        "validation_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Score"
        }
      },
      "required": [
        "proposal_id",
        "base_profile_id",
        "base_profile_sha256",
        "candidate_profile_id",
        "parameter_overrides",
        "rationale"
      ],
      "title": "CandidateProfileProposal",
      "type": "object"
    },
    "ChronologicalSplit": {
      "additionalProperties": false,
      "description": "Non-overlapping train/validation/holdout time ranges.",
      "properties": {
        "contract": {
          "const": "chronological_split_v1",
          "default": "chronological_split_v1",
          "title": "Contract",
          "type": "string"
        },
        "holdout_end": {
          "format": "date",
          "title": "Holdout End",
          "type": "string"
        },
        "holdout_start": {
          "format": "date",
          "title": "Holdout Start",
          "type": "string"
        },
        "train_end": {
          "format": "date",
          "title": "Train End",
          "type": "string"
        },
        "train_start": {
          "format": "date",
          "title": "Train Start",
          "type": "string"
        },
        "validation_end": {
          "format": "date",
          "title": "Validation End",
          "type": "string"
        },
        "validation_start": {
          "format": "date",
          "title": "Validation Start",
          "type": "string"
        }
      },
      "required": [
        "train_start",
        "train_end",
        "validation_start",
        "validation_end",
        "holdout_start",
        "holdout_end"
      ],
      "title": "ChronologicalSplit",
      "type": "object"
    },
    "MaterializationSemanticsReferenceV1": {
      "additionalProperties": false,
      "description": "The calibration-time reference to one frozen semantics set.\n\nThis is the additive field ``CalibrationSearchSpace.materialization_semantics``.\nBecause the search space is part of the deterministic experiment identity,\na semantics-bearing search space freezes its semantics identity before any\ntrial is scored; the reference resolves only against an installed set.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "contract": {
          "const": "materialization_semantics_reference_v1",
          "default": "materialization_semantics_reference_v1",
          "title": "Contract",
          "type": "string"
        },
        "semantics_id": {
          "pattern": "^materializable-parameter-semantics-[0-9a-f]{24}$",
          "title": "Semantics Id",
          "type": "string"
        },
        "semantics_version": {
          "minLength": 1,
          "title": "Semantics Version",
          "type": "string"
        }
      },
      "required": [
        "semantics_id",
        "semantics_version",
        "content_sha256"
      ],
      "title": "MaterializationSemanticsReferenceV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Chronologically guarded calibration experiment and candidate proposal.",
  "properties": {
    "base_profile_id": {
      "minLength": 1,
      "title": "Base Profile Id",
      "type": "string"
    },
    "base_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Profile Sha256",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "contract": {
      "const": "calibration_experiment_v1",
      "default": "calibration_experiment_v1",
      "title": "Contract",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "holdout_locked": {
      "default": true,
      "title": "Holdout Locked",
      "type": "boolean"
    },
    "holdout_observation_ids": {
      "items": {
        "type": "string"
      },
      "title": "Holdout Observation Ids",
      "type": "array"
    },
    "manifest_id": {
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateProfileProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "search_space": {
      "$ref": "#/$defs/CalibrationSearchSpace"
    },
    "selected_trial_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Trial Id"
    },
    "split": {
      "$ref": "#/$defs/ChronologicalSplit"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/CalibrationTrial"
      },
      "maxItems": 1000000,
      "title": "Trials",
      "type": "array"
    }
  },
  "required": [
    "experiment_id",
    "manifest_id",
    "base_profile_id",
    "base_profile_sha256",
    "search_space",
    "split",
    "content_sha256"
  ],
  "title": "CalibrationExperiment",
  "type": "object"
}
