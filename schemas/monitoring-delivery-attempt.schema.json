{
  "$defs": {
    "DeliveryFailureCode": {
      "description": "Safe, secret-free machine-readable failure classifications.",
      "enum": [
        "HTTP_RETRYABLE_STATUS",
        "HTTP_PERMANENT_STATUS",
        "HTTP_REDIRECT_NOT_FOLLOWED",
        "CONNECT_FAILED_PRE_DISPATCH",
        "TIMEOUT_AFTER_DISPATCH",
        "CONNECTION_LOST_AFTER_DISPATCH",
        "RESPONSE_BYTES_EXCEEDED",
        "RETRIES_EXHAUSTED",
        "ORPHANED_DISPATCH",
        "DEADLINE_EXHAUSTED_PRE_DISPATCH"
      ],
      "title": "DeliveryFailureCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable record of exactly one outbound HTTP exchange.\n\n``attempt_number`` is the durable dispatch-slot number the exchange was\nauthorized under: slots are allocated monotonically per delivery, and a\nslot whose outcome never persisted (an orphan consumed by a later\nreceiver-idempotent retry) leaves a legitimate numbering gap in the\nattempt set (6-D2B-R2).  The response body is persisted only as a bounded\nnon-secret digest; raw untrusted response content is never stored.\nError text is a stable machine code so no endpoint URL, token or\nresponse content can leak through diagnostics.",
  "properties": {
    "contract": {
      "const": "monitoring_delivery_attempt_v1",
      "default": "monitoring_delivery_attempt_v1",
      "title": "Contract",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "delivery_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Delivery Id",
      "type": "string"
    },
    "attempt_number": {
      "maximum": 20,
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "classification": {
      "enum": [
        "DELIVERED",
        "RETRYABLE_FAILURE",
        "AMBIGUOUS",
        "PERMANENT_FAILURE"
      ],
      "title": "Classification",
      "type": "string"
    },
    "http_status": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Http Status"
    },
    "response_body_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Body Sha256"
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliveryFailureCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retry_not_before": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Not Before"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "delivery_id",
    "attempt_number",
    "started_at",
    "finished_at",
    "classification",
    "content_sha256"
  ],
  "title": "MonitoringDeliveryAttemptV1",
  "type": "object"
}
