{
  "$defs": {
    "Adjustment": {
      "additionalProperties": false,
      "description": "Explicit economic adjustment with proposal/approval provenance.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target_field": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target Field",
          "type": "string"
        },
        "target_period": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Period"
        },
        "adjustment_type": {
          "$ref": "#/$defs/AdjustmentType"
        },
        "input_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Value"
        },
        "proposed_adjusted_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Adjusted Value"
        },
        "status": {
          "$ref": "#/$defs/AdjustmentStatus"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "proposed_by": {
          "$ref": "#/$defs/ProposedBy"
        },
        "approved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovedBy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "id",
        "target_field",
        "adjustment_type",
        "status",
        "reason",
        "source_evidence_ids",
        "proposed_by"
      ],
      "title": "Adjustment",
      "type": "object"
    },
    "AdjustmentStatus": {
      "description": "Lifecycle state of an adjustment proposal.",
      "enum": [
        "PROPOSED",
        "ACCEPTED",
        "REJECTED"
      ],
      "title": "AdjustmentStatus",
      "type": "string"
    },
    "AdjustmentType": {
      "description": "Adjustment types permitted by the data contract.",
      "enum": [
        "RECLASSIFY",
        "EXCLUDE",
        "INCLUDE",
        "HAIRCUT",
        "OWNERSHIP_ADJUST",
        "UPSTREAMABILITY_ADJUST",
        "NORMALIZE",
        "OTHER"
      ],
      "title": "AdjustmentType",
      "type": "string"
    },
    "AnalystRole": {
      "description": "Stable role names understood by external agent runtimes.",
      "enum": [
        "RESEARCH",
        "QUALITY_ANALYST",
        "SKEPTIC",
        "ADJUDICATOR",
        "REPORT_COMPOSER"
      ],
      "title": "AnalystRole",
      "type": "string"
    },
    "ApprovedBy": {
      "description": "Actor that approved an adjustment.",
      "enum": [
        "RULE_ENGINE",
        "HUMAN"
      ],
      "title": "ApprovedBy",
      "type": "string"
    },
    "ConfidenceLevel": {
      "description": "Qualitative confidence used by metrics, gates and decisions.",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "CounterEvidenceClaim": {
      "additionalProperties": false,
      "description": "A falsifying/counter claim whose evidence must be in the task packet.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "direction": {
          "const": "COUNTER",
          "default": "COUNTER",
          "title": "Direction",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "deterministic_metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Deterministic Metric Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "statement",
        "evidence_ids",
        "confidence"
      ],
      "title": "CounterEvidenceClaim",
      "type": "object"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "description": "A supporting claim whose evidence must be in the task packet.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "direction": {
          "const": "SUPPORT",
          "default": "SUPPORT",
          "title": "Direction",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "deterministic_metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Deterministic Metric Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "statement",
        "evidence_ids",
        "confidence"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "ProposedBy": {
      "description": "Actor that proposed an adjustment.",
      "enum": [
        "RULE_ENGINE",
        "LLM",
        "HUMAN"
      ],
      "title": "ProposedBy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One analyst's structured, untrusted research finding.",
  "properties": {
    "contract": {
      "const": "research_finding_v1",
      "default": "research_finding_v1",
      "title": "Contract",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "listing_id": {
      "minLength": 1,
      "title": "Listing Id",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/AnalystRole"
    },
    "question_id": {
      "minLength": 1,
      "title": "Question Id",
      "type": "string"
    },
    "dimension": {
      "anyOf": [
        {
          "enum": [
            "demand_durability",
            "cyclicality",
            "pricing_power",
            "moat",
            "capital_efficiency",
            "dependency",
            "regulatory_risk",
            "predictability"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dimension"
    },
    "summary": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "supporting_claims": {
      "items": {
        "$ref": "#/$defs/EvidenceClaim"
      },
      "maxItems": 64,
      "title": "Supporting Claims",
      "type": "array"
    },
    "counter_evidence_claims": {
      "items": {
        "$ref": "#/$defs/CounterEvidenceClaim"
      },
      "maxItems": 64,
      "title": "Counter Evidence Claims",
      "type": "array"
    },
    "proposed_score": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Score"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceLevel"
    },
    "deterministic_metric_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Deterministic Metric Ids",
      "type": "array"
    },
    "unresolved_questions": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Unresolved Questions",
      "type": "array"
    },
    "counter_evidence_checked": {
      "default": false,
      "title": "Counter Evidence Checked",
      "type": "boolean"
    },
    "proposed_adjustments": {
      "items": {
        "$ref": "#/$defs/Adjustment"
      },
      "maxItems": 32,
      "title": "Proposed Adjustments",
      "type": "array"
    }
  },
  "required": [
    "contract",
    "id",
    "analysis_id",
    "listing_id",
    "as_of",
    "role",
    "question_id",
    "summary",
    "confidence"
  ],
  "title": "Turtle Value Engine research-finding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/research-finding.schema.json"
}
