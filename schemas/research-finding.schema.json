{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/research-finding.schema.json",
  "title": "Turtle Value Engine Research Finding",
  "type": "object",
  "required": ["contract", "id", "analysis_id", "listing_id", "as_of", "role", "question_id", "summary", "confidence"],
  "properties": {
    "contract": {"const": "research_finding_v1"},
    "id": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "minLength": 1},
    "listing_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "role": {"type": "string", "enum": ["RESEARCH", "QUALITY_ANALYST", "SKEPTIC", "ADJUDICATOR", "REPORT_COMPOSER"]},
    "question_id": {"type": "string", "minLength": 1},
    "dimension": {"type": ["string", "null"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
    "supporting_claims": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/claim"}},
    "counter_evidence_claims": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/counterClaim"}},
    "proposed_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
    "deterministic_metric_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "counter_evidence_checked": {"type": "boolean"},
    "proposed_adjustments": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/adjustment"}}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["id", "statement", "evidence_ids", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "direction": {"const": "SUPPORT"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "deterministic_metric_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "counterClaim": {
      "type": "object",
      "required": ["id", "statement", "evidence_ids", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "direction": {"const": "COUNTER"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "deterministic_metric_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "adjustment": {
      "type": "object",
      "required": ["id", "target_field", "adjustment_type", "status", "reason", "source_evidence_ids", "proposed_by"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target_field": {"type": "string", "minLength": 1},
        "target_period": {"type": ["string", "null"]},
        "adjustment_type": {"type": "string"},
        "input_value": {"type": ["number", "null"]},
        "proposed_adjusted_value": {"type": ["number", "null"]},
        "status": {"const": "PROPOSED"},
        "reason": {"type": "string", "minLength": 1},
        "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "proposed_by": {"const": "LLM"},
        "approved_by": {"type": "null"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
