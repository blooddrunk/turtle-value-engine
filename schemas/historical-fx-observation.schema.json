{
  "additionalProperties": false,
  "description": "Listing-specific FX observation retained before Phase 5 projection.",
  "properties": {
    "contract": {
      "const": "historical_fx_observation_v1",
      "default": "historical_fx_observation_v1",
      "title": "Contract",
      "type": "string"
    },
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "listing_id": {
      "minLength": 1,
      "title": "Listing Id",
      "type": "string"
    },
    "base_currency": {
      "maxLength": 3,
      "minLength": 3,
      "title": "Base Currency",
      "type": "string"
    },
    "quote_currency": {
      "maxLength": 3,
      "minLength": 3,
      "title": "Quote Currency",
      "type": "string"
    },
    "observation_date": {
      "format": "date",
      "title": "Observation Date",
      "type": "string"
    },
    "rate": {
      "exclusiveMinimum": 0,
      "title": "Rate",
      "type": "number"
    },
    "available_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Available At"
    },
    "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Hash",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "listing_id",
    "base_currency",
    "quote_currency",
    "observation_date",
    "rate",
    "source_hash"
  ],
  "title": "HistoricalFXObservation",
  "type": "object"
}
