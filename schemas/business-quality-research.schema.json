{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/business-quality-research.schema.json",
  "title": "Turtle Value Engine Business Quality Research Result",
  "type": "object",
  "required": ["contract", "analysis_id", "listing_id", "as_of", "profile_id", "dimension_results", "dimension_runs", "business_quality", "packets", "tasks", "analyst_runs"],
  "properties": {
    "contract": {"const": "business_quality_research_v1"},
    "analysis_id": {"type": "string", "minLength": 1},
    "listing_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "profile_id": {"type": "string", "minLength": 1},
    "dimension_results": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object"}},
    "dimension_runs": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "required": ["contract", "analysis_id", "listing_id", "as_of", "profile_id", "dimension", "packets", "tasks", "analyst_runs", "proposed_dimension"]}},
    "business_quality": {"type": "object"},
    "packets": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object"}},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object"}},
    "analyst_runs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object"}},
    "proposed_adjustments": {"type": "array", "maxItems": 256, "items": {"type": "object"}},
    "session_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
