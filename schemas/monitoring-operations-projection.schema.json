{
  "$defs": {
    "AlertKind": {
      "description": "Factual alert projections; none is an investment recommendation.",
      "enum": [
        "MATERIAL_EVENT",
        "MANUAL_REVIEW_REQUIRED",
        "REANALYSIS_BLOCKED",
        "REANALYSIS_FAILED",
        "REANALYSIS_SUCCEEDED",
        "CYCLE_FAILED"
      ],
      "title": "AlertKind",
      "type": "string"
    },
    "CanonicalEventType": {
      "description": "Closed set of canonical monitoring event types.",
      "enum": [
        "ANNUAL_REPORT",
        "INTERIM_REPORT",
        "EARNINGS_PREANNOUNCEMENT",
        "DIVIDEND_POLICY_CHANGE",
        "DIVIDEND_DECLARATION",
        "BUYBACK",
        "SHARE_ISSUANCE",
        "MAJOR_ACQUISITION",
        "MAJOR_DISPOSAL",
        "AUDIT_OPINION_CHANGE",
        "REGULATORY_PENALTY",
        "CONTROLLING_SHAREHOLDER_EVENT",
        "MATERIAL_LITIGATION",
        "PROFIT_WARNING",
        "TRADING_SUSPENSION",
        "INFORMATIONAL_DISCLOSURE"
      ],
      "title": "CanonicalEventType",
      "type": "string"
    },
    "CycleStatus": {
      "description": "Terminal outcomes of one synchronous monitoring cycle.",
      "enum": [
        "NO_CHANGE",
        "ALERTS_EMITTED",
        "ATTENTION_REQUIRED",
        "FAILED"
      ],
      "title": "CycleStatus",
      "type": "string"
    },
    "DeliveryFailureCode": {
      "description": "Safe, secret-free machine-readable failure classifications.",
      "enum": [
        "HTTP_RETRYABLE_STATUS",
        "HTTP_PERMANENT_STATUS",
        "HTTP_REDIRECT_NOT_FOLLOWED",
        "CONNECT_FAILED_PRE_DISPATCH",
        "TIMEOUT_AFTER_DISPATCH",
        "CONNECTION_LOST_AFTER_DISPATCH",
        "RESPONSE_BYTES_EXCEEDED",
        "RETRIES_EXHAUSTED",
        "ORPHANED_DISPATCH",
        "DEADLINE_EXHAUSTED_PRE_DISPATCH"
      ],
      "title": "DeliveryFailureCode",
      "type": "string"
    },
    "DeliveryStatus": {
      "description": "Latest-state classifications of one delivery ledger entry.",
      "enum": [
        "PENDING",
        "DELIVERED",
        "RETRYABLE_FAILURE",
        "AMBIGUOUS",
        "PERMANENT_FAILURE",
        "NOOP"
      ],
      "title": "DeliveryStatus",
      "type": "string"
    },
    "EventCursorV1": {
      "additionalProperties": false,
      "description": "Source/listing-scoped high-water mark over processed events.",
      "properties": {
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "last_processed_available_at": {
          "format": "date-time",
          "title": "Last Processed Available At",
          "type": "string"
        },
        "last_event_id": {
          "minLength": 1,
          "title": "Last Event Id",
          "type": "string"
        },
        "advanced_by_run_id": {
          "minLength": 1,
          "title": "Advanced By Run Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "last_processed_available_at",
        "last_event_id",
        "advanced_by_run_id"
      ],
      "title": "EventCursorV1",
      "type": "object"
    },
    "ImpactClass": {
      "description": "Deterministic follow-up severity for one event or listing group.",
      "enum": [
        "NO_REANALYSIS",
        "PARTIAL_REANALYSIS",
        "FULL_REANALYSIS",
        "URGENT_MANUAL_REVIEW"
      ],
      "title": "ImpactClass",
      "type": "string"
    },
    "MonitoringAlertV1": {
      "additionalProperties": false,
      "description": "One bounded, factual, secret-free immutable outbox item.",
      "properties": {
        "contract": {
          "const": "monitoring_alert_v1",
          "default": "monitoring_alert_v1",
          "title": "Contract",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "alert_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Id",
          "type": "string"
        },
        "cycle_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cycle Id",
          "type": "string"
        },
        "watchlist_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Watchlist Id",
          "type": "string"
        },
        "monitoring_run_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monitoring Run Id"
        },
        "event_batch_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Batch Id"
        },
        "kind": {
          "$ref": "#/$defs/AlertKind"
        },
        "listing_id": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listing Id"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Event Ids",
          "type": "array"
        },
        "event_types": {
          "items": {
            "$ref": "#/$defs/CanonicalEventType"
          },
          "maxItems": 256,
          "title": "Event Types",
          "type": "array"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available At"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "job_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReanalysisJobStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failure_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "analysis_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Id"
        },
        "surface_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface Id"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "alert_id",
        "cycle_id",
        "watchlist_id",
        "kind",
        "reason_code",
        "message",
        "content_sha256"
      ],
      "title": "MonitoringAlertV1",
      "type": "object"
    },
    "MonitoringDeliveryStateV1": {
      "additionalProperties": false,
      "description": "Atomic latest state pointer for one delivery identity.\n\nThe state is fully derived from the immutable intent plus the immutable\nattempt set, so a crash between an attempt write and this pointer's\npublication is repaired deterministically without repeating the request.",
      "properties": {
        "contract": {
          "const": "monitoring_delivery_state_v1",
          "default": "monitoring_delivery_state_v1",
          "title": "Contract",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "delivery_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DeliveryStatus"
        },
        "terminal": {
          "title": "Terminal",
          "type": "boolean"
        },
        "attempt_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "terminal_attempt_number": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Attempt Number"
        },
        "terminal_attempt_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Attempt Content Sha256"
        },
        "last_http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Http Status"
        },
        "last_error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryFailureCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "next_attempt_not_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Attempt Not Before"
        },
        "intent_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Content Sha256",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "delivery_id",
        "status",
        "terminal",
        "attempt_count",
        "intent_content_sha256",
        "updated_at",
        "content_sha256"
      ],
      "title": "MonitoringDeliveryStateV1",
      "type": "object"
    },
    "MonitoringOperationsActivationV1": {
      "additionalProperties": false,
      "description": "The one projected activation: active when unfinished, else latest terminal.",
