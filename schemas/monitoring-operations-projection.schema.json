          "default": null,
          "title": "Failure Code"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "watchlist_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Watchlist Id",
          "type": "string"
        },
        "monitoring_run_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monitoring Run Id"
        },
        "event_batch_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Batch Id"
        },
        "next_state_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next State Id"
        },
        "alert_batch_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Batch Id",
          "type": "string"
        },
        "alert_batch_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Batch Content Sha256",
          "type": "string"
        },
        "result_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Content Sha256",
          "type": "string"
        },
        "pointer_published": {
          "title": "Pointer Published",
          "type": "boolean"
        },
        "alert_count": {
          "minimum": 0,
          "title": "Alert Count",
          "type": "integer"
        },
        "alerts": {
          "items": {
            "$ref": "#/$defs/MonitoringAlertV1"
          },
          "maxItems": 1024,
          "title": "Alerts",
          "type": "array"
        }
      },
      "required": [
        "cycle_id",
        "status",
        "as_of",
        "watchlist_id",
        "alert_batch_id",
        "alert_batch_content_sha256",
        "result_content_sha256",
        "pointer_published",
        "alert_count"
      ],
      "title": "MonitoringOperationsCycleV1",
      "type": "object"
    },
    "MonitoringOperationsDeliveryAttemptV1": {
      "additionalProperties": false,
      "description": "One persisted delivery outcome (slot number may legitimately gap).",
      "properties": {
        "attempt_number": {
          "minimum": 1,
