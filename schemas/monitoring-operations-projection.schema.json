        "cycle_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cycle Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CycleStatus"
        },
        "failure_code": {
          "anyOf": [
            {
              "maxLength": 128,
