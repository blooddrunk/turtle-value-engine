        "activation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Activation Id",
          "type": "string"
        },
        "runner_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runner Id",
          "type": "string"
        },
        "cycle_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cycle Id",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "intent_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Content Sha256",
          "type": "string"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonitoringOperationsReceiptV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "activation_id",
        "runner_id",
        "cycle_id",
        "as_of",
        "created_at",
        "request_fingerprint",
        "intent_content_sha256"
      ],
      "title": "MonitoringOperationsActivationV1",
      "type": "object"
    },
    "MonitoringOperationsCycleV1": {
      "additionalProperties": false,
