    "MonitoringOperationsDeliveryV1": {
      "additionalProperties": false,
      "description": "One D2B delivery bound to the projected activation.\n\n``state.attempt_count`` counts persisted attempt outcomes while\n``dispatch_claim_count`` counts consumed authorized outbound transport\nslots; after an orphaned dispatch the two legitimately differ and the\nunresolved slot numbers stay explicit (6-D2B-R2).",
      "properties": {
        "delivery_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Delivery Id",
          "type": "string"
        },
        "runner_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runner Id",
          "type": "string"
        },
        "activation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Activation Id",
          "type": "string"
        },
        "cycle_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cycle Id",
          "type": "string"
        },
        "alert_batch_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Batch Id",
          "type": "string"
        },
        "destination_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Destination Id",
          "type": "string"
        },
        "transport": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Transport",
          "type": "string"
        },
        "payload_contract": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Payload Contract",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "empty_outbox": {
          "title": "Empty Outbox",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/MonitoringDeliveryStateV1"
        },
        "pointer_published": {
          "title": "Pointer Published",
          "type": "boolean"
        },
        "pointer_status": {
          "enum": [
            "CURRENT",
            "MISSING",
            "STALE_REPAIRABLE"
          ],
          "title": "Pointer Status",
          "type": "string"
        },
        "dispatch_claim_count": {
          "minimum": 0,
          "title": "Dispatch Claim Count",
          "type": "integer"
        },
        "unresolved_claim_numbers": {
          "items": {
            "type": "integer"
          },
          "maxItems": 64,
          "title": "Unresolved Claim Numbers",
          "type": "array"
        },
        "unresolved_dispatch_claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonitoringOperationsUnresolvedClaimV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/MonitoringOperationsDeliveryAttemptV1"
          },
          "maxItems": 64,
          "title": "Attempts",
          "type": "array"
        }
      },
      "required": [
        "delivery_id",
        "runner_id",
        "activation_id",
        "cycle_id",
        "alert_batch_id",
        "destination_id",
        "transport",
        "payload_contract",
        "payload_sha256",
        "empty_outbox",
        "created_at",
        "state",
        "pointer_published",
        "pointer_status",
        "dispatch_claim_count"
      ],
      "title": "MonitoringOperationsDeliveryV1",
      "type": "object"
    },
