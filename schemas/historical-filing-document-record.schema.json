{
  "$defs": {
    "Market": {
      "description": "Listing market; A and H listings are never merged by the simulator.",
      "enum": [
        "A",
        "H"
      ],
      "title": "Market",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One immutable official filing revision projected from a raw document.",
  "properties": {
    "contract": {
      "const": "historical_filing_document_record_v1",
      "default": "historical_filing_document_record_v1",
      "title": "Contract",
      "type": "string"
    },
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "filing_id": {
      "minLength": 1,
      "title": "Filing Id",
      "type": "string"
    },
    "listing_id": {
      "minLength": 1,
      "title": "Listing Id",
      "type": "string"
    },
    "market": {
      "$ref": "#/$defs/Market"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "document_type": {
      "minLength": 1,
      "title": "Document Type",
      "type": "string"
    },
    "published_at": {
      "format": "date",
      "title": "Published At",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "source_uri": {
      "minLength": 1,
      "title": "Source Uri",
      "type": "string"
    },
    "document_locator": {
      "minLength": 1,
      "title": "Document Locator",
      "type": "string"
    },
    "source_document_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Document Id"
    },
    "report_period": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Period"
    },
    "document_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Document Hash",
      "type": "string"
    },
    "document_size": {
      "minimum": 1,
      "title": "Document Size",
      "type": "integer"
    },
    "media_type": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "revision_identity": {
      "minLength": 1,
      "title": "Revision Identity",
      "type": "string"
    },
    "source_artifact_id": {
      "minLength": 1,
      "title": "Source Artifact Id",
      "type": "string"
    },
    "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Hash",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "filing_id",
    "listing_id",
    "market",
    "source",
    "title",
    "document_type",
    "published_at",
    "available_at",
    "retrieved_at",
    "source_uri",
    "document_locator",
    "document_hash",
    "document_size",
    "media_type",
    "revision_identity",
    "source_artifact_id",
    "source_hash"
  ],
  "title": "HistoricalFilingDocumentRecord",
  "type": "object"
}
