{
  "additionalProperties": false,
  "description": "The deterministic result dossier of one signature verification.\n\n``VERIFIED`` requires every canonical check to pass; any failure keeps\nthe dossier ``REJECTED`` naming the failing checks.  The dossier binds\nthe registry by id **and** exact ``content_sha256`` (``registry_id`` is\nderived from key ids only and is not a trust-content identity: the same\nkey set re-windowed, re-scoped, revoked or un-revoked keeps the id while\nchanging the content), plus the key, statement and decision-content\nidentities, carries no wall-clock field, and is reproducible\nbyte-for-byte offline.",
  "properties": {
    "contract": {
      "const": "owner_provenance_verification_v1",
      "default": "owner_provenance_verification_v1",
      "title": "Contract",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "verification_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Verification Id",
      "type": "string"
    },
    "registry_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Registry Id",
      "type": "string"
    },
    "registry_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registry Content Sha256",
      "type": "string"
    },
    "key_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key Id"
    },
    "algorithm": {
      "const": "ED25519",
      "default": "ED25519",
      "title": "Algorithm",
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "VERIFIED",
        "REJECTED"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "revocation_status": {
      "enum": [
        "NOT_REVOKED",
        "REVOKED",
        "UNKNOWN"
      ],
      "title": "Revocation Status",
      "type": "string"
    },
    "key_validity": {
      "enum": [
        "WITHIN_WINDOW",
        "OUTSIDE_WINDOW",
        "UNKNOWN"
      ],
      "title": "Key Validity",
      "type": "string"
    },
    "decision_input_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Input Content Sha256",
      "type": "string"
    },
    "evidence_content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Content Sha256"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "detail": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Detail",
      "type": "string"
    },
    "checks": {
      "items": false,
      "maxItems": 9,
      "minItems": 9,
      "prefixItems": [
        {
          "properties": {
            "name": {
              "const": "ALGORITHM_SUPPORTED"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "KEY_RESOLUTION"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "KEY_IDENTITY_BINDING"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "KEY_SCOPE_AUTHORIZED"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "KEY_VALIDITY_WINDOW"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "KEY_NOT_REVOKED"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "DECISION_CONTENT_BINDING"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "PURPOSE_BINDING"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "SIGNATURE_VERIFIED"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        }
      ],
      "title": "Checks",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "verification_id",
    "registry_id",
    "registry_content_sha256",
    "verification_status",
    "revocation_status",
    "key_validity",
    "decision_input_content_sha256",
    "reason_code",
    "detail",
    "checks",
    "content_sha256"
  ],
  "title": "OwnerProvenanceVerificationV1",
  "type": "object"
}
