{
  "additionalProperties": false,
  "description": "Immutable recovery intent persisted before the config restoration.\n\nWritten while the config still holds the receipt's activated bytes, this\nrecord is *not* a claim that the rollback completed: it binds the exact\nreceipt, config path and byte hashes an interrupted rollback can be\nverified against, so a retry that already observes the restored bytes\ncan finalize the durable rollback outcome deterministically without\nrewriting the config — and without fabricating an outcome for a rollback\nthat never provably ran.",
  "properties": {
    "activated_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Activated Config Sha256",
      "type": "string"
    },
    "activation_id": {
      "maxLength": 168,
      "minLength": 1,
      "title": "Activation Id",
      "type": "string"
    },
    "before_image_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Before Image Sha256",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "contract": {
      "const": "profile_activation_rollback_intent_v1",
      "default": "profile_activation_rollback_intent_v1",
      "title": "Contract",
      "type": "string"
    },
    "project_config_path": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Project Config Path",
      "type": "string"
    },
    "purpose": {
      "const": "ROLLBACK_RECOVERY_INTENT",
      "default": "ROLLBACK_RECOVERY_INTENT",
      "title": "Purpose",
      "type": "string"
    },
    "receipt_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Content Sha256",
      "type": "string"
    },
    "restored_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Restored Config Sha256",
      "type": "string"
    },
    "rollback_id": {
      "maxLength": 168,
      "minLength": 1,
      "title": "Rollback Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "rollback_id",
    "activation_id",
    "receipt_content_sha256",
    "project_config_path",
    "activated_config_sha256",
    "restored_config_sha256",
    "before_image_sha256",
    "content_sha256"
  ],
  "title": "ProfileActivationRollbackIntentV1",
  "type": "object"
}
