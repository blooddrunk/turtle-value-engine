    "content_sha256": {
      "description": "Exact full-projection identity: the SHA-256 over the canonical JSON serialization of the complete summary payload EXCLUDING this field itself (no hash cycle), recomputed and enforced by the model validator. Two summaries may share one summary_id (the semantic observed-core identity) while differing here \u2014 this field is what distinguishes them. Compare it (or the whole serialized payload) for byte-exact replay equality and use it as the exact-content key whenever a consumer persists summaries; it proves integrity of the observed bytes only and is never authenticity, authority or an approval.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
