{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/evidence-packet.schema.json",
  "title": "Turtle Value Engine Bounded Evidence Packet",
  "type": "object",
  "required": ["contract", "packet_id", "analysis_id", "listing_id", "as_of", "profile_id", "role", "question", "intent", "evidence", "facts", "deterministic_metrics", "content_sha256"],
  "properties": {
    "contract": {"const": "evidence_packet_v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "minLength": 1},
    "listing_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "profile_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "enum": ["RESEARCH", "QUALITY_ANALYST", "SKEPTIC", "ADJUDICATOR", "REPORT_COMPOSER"]},
    "question": {"$ref": "#/$defs/question"},
    "intent": {"type": "string", "enum": ["THESIS", "FALSIFICATION", "ADJUDICATION"]},
    "evidence": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidence"}},
    "facts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/packetFact"}},
    "deterministic_metrics": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/metric"}},
    "available_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "available_fact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "undated_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "protocol_version": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "intent", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "dimension": {"type": ["string", "null"]},
        "intent": {"type": "string", "enum": ["THESIS", "FALSIFICATION", "ADJUDICATION"]},
        "text": {"type": "string", "minLength": 1},
        "focus_areas": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "issuer": {"type": ["string", "null"]},
        "published_date": {"type": ["string", "null"], "format": "date"},
        "fiscal_period": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "document_id": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": ["string", "null"]},
        "table_or_note": {"type": ["string", "null"]},
        "locator": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "direction", "strength", "statement", "source", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "enum": ["SUPPORT", "COUNTER", "CONTEXT"]},
        "strength": {"type": "string", "enum": ["E3", "E2", "E1", "E0"]},
        "statement": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "metric_context": {"type": ["object", "null"]},
        "notes": {"type": ["string", "null"]},
        "provenance": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },
    "packetFact": {
      "type": "object",
      "required": ["fact_id", "field", "value", "period", "source_evidence_ids", "confidence"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "currency": {"type": ["string", "null"]},
        "period": {"type": "string", "minLength": 1},
        "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "origin": {"type": "string", "enum": ["NORMALIZED_SOURCE_FACT", "EFFECTIVE_INPUT_FACT"]},
        "source_fact_id": {"type": ["string", "null"]},
        "applied_adjustment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "period": {"type": ["string", "null"]},
        "calculation_contract": {"const": "DETERMINISTIC_ENGINE"},
        "source_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
