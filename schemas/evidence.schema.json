{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/evidence.schema.json",
  "title": "Turtle Value Engine Evidence",
  "description": "Auditable evidence item used by quantitative adjustments, qualitative judgments, gates and final decisions.",
  "type": "object",
  "required": [
    "id",
    "direction",
    "strength",
    "statement",
    "source",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "enum": ["SUPPORT", "COUNTER", "CONTEXT"]
    },
    "strength": {
      "type": "string",
      "enum": ["E3", "E2", "E1", "E0"],
      "description": "E3 audited/formal primary data; E2 formal operating disclosure; E1 credible independent secondary evidence; E0 inference only."
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "description": "Concise paraphrased fact or inference supported by the source; avoid unnecessary verbatim quotation."
    },
    "metric_context": {
      "type": ["object", "null"],
      "properties": {
        "metric": {"type": "string"},
        "period": {"type": ["string", "null"]},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "currency": {"type": ["string", "null"], "minLength": 3, "maxLength": 3}
      },
      "required": ["metric"],
      "additionalProperties": false
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": ["string", "null"]
    },
    "provenance": {
      "anyOf": [
        {"$ref": "#/$defs/evidenceProvenance"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "evidenceProvenance": {
      "type": "object",
      "required": [
        "filing_id",
        "filing_source",
        "source_document_id",
        "report_period",
        "content_sha256",
        "content_size",
        "media_type",
        "extraction_contract",
        "parser_id",
        "parser_version",
        "block_sequence",
        "block_sha256"
      ],
      "properties": {
        "filing_id": {
          "type": "string",
          "pattern": "^filing-[0-9a-f]{24}$"
        },
        "filing_source": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "source_document_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "report_period": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_size": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "extraction_contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parser_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parser_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "block_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "block_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ANNUAL_REPORT",
            "INTERIM_REPORT",
            "EXCHANGE_FILING",
            "COMPANY_ANNOUNCEMENT",
            "COMPANY_OPERATING_DISCLOSURE",
            "GOVERNMENT",
            "REGULATOR",
            "INDUSTRY_ASSOCIATION",
            "STRUCTURED_DATA_VENDOR",
            "RESEARCH_PROVIDER",
            "NEWS",
            "OTHER"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "issuer": {"type": ["string", "null"]},
        "published_date": {"type": ["string", "null"], "format": "date"},
        "fiscal_period": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "minLength": 1, "format": "uri"},
        "document_id": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": ["string", "null"]},
        "table_or_note": {"type": ["string", "null"]},
        "locator": {"type": ["string", "null"], "description": "Additional stable locator such as line range, filing item, note number or table label."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
