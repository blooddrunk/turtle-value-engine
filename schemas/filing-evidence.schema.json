{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/filing-evidence.schema.json",
  "title": "Turtle Value Engine Filing Evidence Store Record",
  "description": "One deterministic Evidence item bound to an exact official filing extraction block.",
  "type": "object",
  "required": [
    "cache_format_version",
    "contract",
    "evidence",
    "filing",
    "content_sha256",
    "content_size",
    "media_type",
    "extraction_contract",
    "parser_id",
    "parser_version",
    "block",
    "record_sha256"
  ],
  "properties": {
    "cache_format_version": {"const": 1},
    "contract": {"const": "filing_evidence_v1"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "filing": {"$ref": "#/$defs/filing"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_size": {"type": "integer", "minimum": 1, "maximum": 52428800},
    "media_type": {
      "type": "string",
      "enum": ["application/pdf", "text/html", "application/xhtml+xml"]
    },
    "extraction_contract": {
      "type": "string",
      "const": "filing_report_extraction_v1"
    },
    "parser_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "parser_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "block": {"$ref": "#/$defs/block"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "direction",
        "strength",
        "statement",
        "source",
        "confidence",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^filing-evidence-[0-9a-f]{24}$"
        },
        "direction": {
          "type": "string",
          "enum": ["SUPPORT", "COUNTER", "CONTEXT"]
        },
        "strength": {
          "type": "string",
          "enum": ["E3", "E2", "E1", "E0"]
        },
        "statement": {"type": "string", "minLength": 1},
        "metric_context": {"$ref": "#/$defs/metricContext"},
        "source": {"$ref": "#/$defs/source"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "notes": {"type": ["string", "null"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "metricContext": {
      "type": ["object", "null"],
      "properties": {
        "metric": {"type": "string"},
        "period": {"type": ["string", "null"]},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "currency": {
          "type": ["string", "null"],
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": ["metric"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type", "title", "published_date", "fiscal_period", "url", "document_id", "page", "section", "locator"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ANNUAL_REPORT", "INTERIM_REPORT"]
        },
        "title": {"type": "string", "minLength": 1},
        "issuer": {"type": ["string", "null"]},
        "published_date": {"type": ["string", "null"], "format": "date"},
        "fiscal_period": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "document_id": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": ["string", "null"]},
        "table_or_note": {"type": ["string", "null"]},
        "locator": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "filing_id",
        "filing_source",
        "source_document_id",
        "report_period",
        "content_sha256",
        "content_size",
        "media_type",
        "extraction_contract",
        "parser_id",
        "parser_version",
        "block_sequence",
        "block_sha256"
      ],
      "properties": {
        "filing_id": {"type": "string", "pattern": "^filing-[0-9a-f]{24}$"},
        "filing_source": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "source_document_id": {"type": ["string", "null"]},
        "report_period": {"type": ["string", "null"]},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_size": {"type": "integer", "minimum": 1, "maximum": 52428800},
        "media_type": {"type": "string", "enum": ["application/pdf", "text/html", "application/xhtml+xml"]},
        "extraction_contract": {"type": "string", "const": "filing_report_extraction_v1"},
        "parser_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "parser_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "block_sequence": {"type": "integer", "minimum": 1, "maximum": 2048},
        "block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": ["sequence", "page", "section", "locator", "text_sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 2048},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": ["string", "null"], "minLength": 1},
        "locator": {"type": "string", "minLength": 1, "maxLength": 128},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {"page": {"type": "integer", "minimum": 1}, "section": {"type": "null"}}
        },
        {
          "properties": {"page": {"type": "null"}, "section": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "filing": {
      "type": "object",
      "required": [
        "filing_id",
        "listing_id",
        "market",
        "source",
        "title",
        "document_type",
        "published_date",
        "url",
        "source_document_id",
        "report_period",
        "issuer_name"
      ],
      "properties": {
        "filing_id": {"type": "string", "pattern": "^filing-[0-9a-f]{24}$"},
        "listing_id": {"type": "string", "pattern": "^(?:(?:SH|SZ|BJ)\\d{6}|HK\\d{5})$"},
        "market": {"type": "string", "enum": ["A", "H"]},
        "source": {
          "type": "string",
          "enum": ["CNINFO", "SSE", "SZSE", "BSE", "A_COMPANY_ANNOUNCEMENT", "HKEXNEWS", "H_COMPANY_REPORT", "H_COMPANY_ANNOUNCEMENT"]
        },
        "title": {"type": "string", "minLength": 1},
        "document_type": {"type": "string", "minLength": 1},
        "published_date": {"type": "string", "format": "date"},
        "url": {"type": "string", "format": "uri"},
        "source_document_id": {"type": ["string", "null"]},
        "report_period": {"type": ["string", "null"]},
        "issuer_name": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
