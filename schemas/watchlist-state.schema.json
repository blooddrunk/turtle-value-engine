{
  "$defs": {
    "CanonicalEventType": {
      "description": "Closed set of canonical monitoring event types.",
      "enum": [
        "ANNUAL_REPORT",
        "INTERIM_REPORT",
        "EARNINGS_PREANNOUNCEMENT",
        "DIVIDEND_POLICY_CHANGE",
        "DIVIDEND_DECLARATION",
        "BUYBACK",
        "SHARE_ISSUANCE",
        "MAJOR_ACQUISITION",
        "MAJOR_DISPOSAL",
        "AUDIT_OPINION_CHANGE",
        "REGULATORY_PENALTY",
        "CONTROLLING_SHAREHOLDER_EVENT",
        "MATERIAL_LITIGATION",
        "PROFIT_WARNING",
        "TRADING_SUSPENSION",
        "INFORMATIONAL_DISCLOSURE"
      ],
      "title": "CanonicalEventType",
      "type": "string"
    },
    "EventCursorV1": {
      "additionalProperties": false,
      "description": "Source/listing-scoped high-water mark over processed events.",
      "properties": {
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "last_processed_available_at": {
          "format": "date-time",
          "title": "Last Processed Available At",
          "type": "string"
        },
        "last_event_id": {
          "minLength": 1,
          "title": "Last Event Id",
          "type": "string"
        },
        "advanced_by_run_id": {
          "minLength": 1,
          "title": "Advanced By Run Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "last_processed_available_at",
        "last_event_id",
        "advanced_by_run_id"
      ],
      "title": "EventCursorV1",
      "type": "object"
    },
    "ProcessedEventRecordV1": {
      "additionalProperties": false,
      "description": "Retained processed-event identity used for duplicate/conflict checks.",
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/CanonicalEventType"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "available_at",
        "content_sha256"
      ],
      "title": "ProcessedEventRecordV1",
      "type": "object"
    },
    "WatchlistEntryStateV1": {
      "additionalProperties": false,
      "description": "Per-listing monitoring state; absent facts stay explicitly absent.",
      "properties": {
        "listing_id": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "last_analysis_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Analysis Id"
        },
        "last_surface_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Surface Id"
        },
        "last_analysis_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Analysis As Of"
        },
        "last_profile_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Profile Id"
        },
        "last_engine_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Engine Version"
        },
        "last_deterministic_result": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Deterministic Result"
        },
        "last_filing_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Filing Id"
        },
        "last_source_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Source Id"
        },
        "cursors": {
          "items": {
            "$ref": "#/$defs/EventCursorV1"
          },
          "title": "Cursors",
          "type": "array"
        },
        "processed_events": {
          "items": {
            "$ref": "#/$defs/ProcessedEventRecordV1"
          },
          "title": "Processed Events",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        }
      },
      "required": [
        "listing_id"
      ],
      "title": "WatchlistEntryStateV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Committed watchlist monitoring state with a canonical identity.",
  "properties": {
    "contract": {
      "const": "watchlist_state_v1",
      "default": "watchlist_state_v1",
      "title": "Contract",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "watchlist_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
      "title": "Watchlist Id",
      "type": "string"
    },
    "last_committed_run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Committed Run Id"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/WatchlistEntryStateV1"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "state_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Id",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "watchlist_id",
    "entries",
    "state_id",
    "content_sha256"
  ],
  "title": "WatchlistStateV1",
  "type": "object"
}
