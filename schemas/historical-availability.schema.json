{
  "$defs": {
    "AvailabilityStatus": {
      "enum": [
        "KNOWN",
        "UNKNOWN",
        "EXPLICIT_POLICY"
      ],
      "title": "AvailabilityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Availability metadata for one frozen historical artifact.",
  "properties": {
    "contract": {
      "const": "historical_availability_v1",
      "default": "historical_availability_v1",
      "title": "Contract",
      "type": "string"
    },
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "period_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period End"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "available_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Available At"
    },
    "retrieved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieved At"
    },
    "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "source_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "status": {
      "$ref": "#/$defs/AvailabilityStatus",
      "default": "KNOWN"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "contract",
    "artifact_id",
    "source_hash"
  ],
  "title": "Turtle Value Engine historical-availability",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/historical-availability.schema.json"
}
