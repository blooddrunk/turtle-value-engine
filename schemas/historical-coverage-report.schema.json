{
  "$defs": {
    "CoverageClaim": {
      "description": "Evidence level declared for the target, never inferred from row count.",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "CoverageClaim",
      "type": "string"
    },
    "CoverageEvidenceBasis": {
      "description": "Evidence basis required before a coverage claim can be trusted.\n\nA row count is meaningful for trading sessions, but an empty corporate\naction or filing result is not evidence that the source was complete.  The\nbasis is additive so historical-v1 manifests without it remain readable.",
      "enum": [
        "TRADING_SESSIONS",
        "OBSERVATION_SESSIONS",
        "MEMBERSHIP_INTERVALS",
        "LIFECYCLE_INDEX",
        "EVENT_INDEX",
        "FILING_INDEX",
        "ARCHIVE_BINDING",
        "EXPLICIT_SOURCE_SCOPE"
      ],
      "title": "CoverageEvidenceBasis",
      "type": "string"
    },
    "HistoricalCoverageRecord": {
      "additionalProperties": false,
      "description": "Coverage for one listing and one source category over one period.",
      "properties": {
        "contract": {
          "const": "historical_coverage_record_v1",
          "default": "historical_coverage_record_v1",
          "title": "Contract",
          "type": "string"
        },
        "evidence_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverageEvidenceBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_session_count": {
          "minimum": 0,
          "title": "Expected Session Count",
          "type": "integer"
        },
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "missing_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Missing Dates",
          "type": "array"
        },
        "observed_session_count": {
          "minimum": 0,
          "title": "Observed Session Count",
          "type": "integer"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "source_artifact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Artifact Ids",
          "type": "array"
        },
        "source_kind": {
          "$ref": "#/$defs/HistoricalSourceKind"
        },
        "status": {
          "$ref": "#/$defs/CoverageClaim"
        },
        "terminal_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoricalTerminalOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_kind",
        "listing_id",
        "period_start",
        "period_end",
        "expected_session_count",
        "observed_session_count",
        "source_artifact_ids",
        "status"
      ],
      "title": "HistoricalCoverageRecord",
      "type": "object"
    },
    "HistoricalSourceKind": {
      "description": "Source categories required to make a historical claim auditable.",
      "enum": [
        "UNIVERSE_MEMBERSHIP",
        "LISTING_LIFECYCLE",
        "DELISTINGS",
        "PRICES",
        "CORPORATE_ACTIONS",
        "BENCHMARK",
        "FX",
        "FILINGS",
        "RESEARCH_ARCHIVE"
      ],
      "title": "HistoricalSourceKind",
      "type": "string"
    },
    "HistoricalTerminalOutcome": {
      "description": "Terminal lifecycle outcome without pretending all outcomes have value.",
      "enum": [
        "ACTIVE",
        "DELISTED",
        "ACQUIRED_CANCELLED",
        "TRANSFERRED",
        "PROLONGED_SUSPENSION",
        "UNRESOLVED_TERMINAL",
        "UNKNOWN"
      ],
      "title": "HistoricalTerminalOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic per-listing/per-period coverage report.",
  "properties": {
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "contract": {
      "const": "historical_coverage_report_v1",
      "default": "historical_coverage_report_v1",
      "title": "Contract",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/HistoricalCoverageRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "target_id": {
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "target_id",
    "records",
    "content_sha256"
  ],
  "title": "HistoricalCoverageReport",
  "type": "object"
}
