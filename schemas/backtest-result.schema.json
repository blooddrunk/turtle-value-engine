      "properties": {
        "bucket_key": {
          "minLength": 1,
          "title": "Bucket Key",
          "type": "string"
        },
        "horizon": {
          "pattern": "^[0-9]+[DWMY]$",
          "title": "Horizon",
          "type": "string"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "complete_count": {
          "minimum": 0,
          "title": "Complete Count",
          "type": "integer"
        },
        "mean_price_return": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
