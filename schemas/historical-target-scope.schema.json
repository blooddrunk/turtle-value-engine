{
  "$defs": {
    "CoverageClaim": {
      "description": "Evidence level declared for the target, never inferred from row count.",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "CoverageClaim",
      "type": "string"
    },
    "HistoricalSourceKind": {
      "description": "Source categories required to make a historical claim auditable.",
      "enum": [
        "UNIVERSE_MEMBERSHIP",
        "LISTING_LIFECYCLE",
        "DELISTINGS",
        "PRICES",
        "CORPORATE_ACTIONS",
        "BENCHMARK",
        "FX",
        "FILINGS",
        "RESEARCH_ARCHIVE"
      ],
      "title": "HistoricalSourceKind",
      "type": "string"
    },
    "Market": {
      "description": "Listing market; A and H listings are never merged by the simulator.",
      "enum": [
        "A",
        "H"
      ],
      "title": "Market",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Named, bounded universe against which all production claims are scoped.",
  "properties": {
    "contract": {
      "const": "historical_target_scope_v1",
      "default": "historical_target_scope_v1",
      "title": "Contract",
      "type": "string"
    },
    "target_id": {
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "target_name": {
      "minLength": 1,
      "title": "Target Name",
      "type": "string"
    },
    "universe_id": {
      "minLength": 1,
      "title": "Universe Id",
      "type": "string"
    },
    "markets": {
      "items": {
        "$ref": "#/$defs/Market"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Markets",
      "type": "array"
    },
    "listing_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Listing Ids",
      "type": "array"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "membership_claim": {
      "enum": [
        "HISTORICAL",
        "FIXED_RESEARCH_UNIVERSE",
        "UNKNOWN"
      ],
      "title": "Membership Claim",
      "type": "string"
    },
    "coverage_claim": {
      "$ref": "#/$defs/CoverageClaim"
    },
    "required_source_kinds": {
      "items": {
        "$ref": "#/$defs/HistoricalSourceKind"
      },
      "minItems": 1,
      "title": "Required Source Kinds",
      "type": "array"
    },
    "calendar_ids": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Calendar Ids",
      "type": "object"
    },
    "listing_markets": {
      "additionalProperties": {
        "$ref": "#/$defs/Market"
      },
      "title": "Listing Markets",
      "type": "object"
    },
    "licensing_scope": {
      "minLength": 1,
      "title": "Licensing Scope",
      "type": "string"
    }
  },
  "required": [
    "target_id",
    "target_name",
    "universe_id",
    "markets",
    "listing_ids",
    "start_date",
    "end_date",
    "membership_claim",
    "coverage_claim",
    "required_source_kinds",
    "licensing_scope"
  ],
  "title": "HistoricalTargetScope",
  "type": "object"
}
