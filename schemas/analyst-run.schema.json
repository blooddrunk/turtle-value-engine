{
  "$defs": {
    "Adjustment": {
      "additionalProperties": false,
      "description": "Explicit economic adjustment with proposal/approval provenance.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target_field": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target Field",
          "type": "string"
        },
        "target_period": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Period"
        },
        "adjustment_type": {
          "$ref": "#/$defs/AdjustmentType"
        },
        "input_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Value"
        },
        "proposed_adjusted_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Adjusted Value"
        },
        "status": {
          "$ref": "#/$defs/AdjustmentStatus"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "proposed_by": {
          "$ref": "#/$defs/ProposedBy"
        },
        "approved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovedBy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "id",
        "target_field",
        "adjustment_type",
        "status",
        "reason",
        "source_evidence_ids",
        "proposed_by"
      ],
      "title": "Adjustment",
      "type": "object"
    },
    "AdjustmentStatus": {
      "description": "Lifecycle state of an adjustment proposal.",
      "enum": [
        "PROPOSED",
        "ACCEPTED",
        "REJECTED"
      ],
      "title": "AdjustmentStatus",
      "type": "string"
    },
    "AdjustmentType": {
      "description": "Adjustment types permitted by the data contract.",
      "enum": [
        "RECLASSIFY",
        "EXCLUDE",
        "INCLUDE",
        "HAIRCUT",
        "OWNERSHIP_ADJUST",
        "UPSTREAMABILITY_ADJUST",
        "NORMALIZE",
        "OTHER"
      ],
      "title": "AdjustmentType",
      "type": "string"
    },
    "AgentRunMetadata": {
      "additionalProperties": false,
      "description": "Safe execution metadata; it intentionally has no raw provider payload.",
      "properties": {
        "execution_mode": {
          "$ref": "#/$defs/AnalystExecutionMode",
          "default": "EXTERNAL"
        },
        "provider_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "prompt_version": {
          "default": "research-prompt-v1",
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "protocol_version": {
          "default": "research-protocol-v1",
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "max_context_items": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Context Items"
        },
        "max_output_claims": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Claims"
        },
        "max_unresolved_questions": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Unresolved Questions"
        },
        "max_output_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Bytes"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "AgentRunMetadata",
      "type": "object"
    },
    "AnalystExecutionMode": {
      "description": "Whether a run came from a frozen client or an external model runtime.",
      "enum": [
        "SCRIPTED",
        "EXTERNAL",
        "LIVE"
      ],
      "title": "AnalystExecutionMode",
      "type": "string"
    },
    "AnalystRole": {
      "description": "Stable role names understood by external agent runtimes.",
      "enum": [
        "RESEARCH",
        "QUALITY_ANALYST",
        "SKEPTIC",
        "ADJUDICATOR",
        "REPORT_COMPOSER"
      ],
      "title": "AnalystRole",
      "type": "string"
    },
    "AnalystRunStatus": {
      "description": "Persisted terminal states for analyst calls.",
      "enum": [
        "COMPLETED"
      ],
      "title": "AnalystRunStatus",
      "type": "string"
    },
    "ApprovedBy": {
      "description": "Actor that approved an adjustment.",
      "enum": [
        "RULE_ENGINE",
        "HUMAN"
      ],
      "title": "ApprovedBy",
      "type": "string"
    },
    "ConfidenceLevel": {
      "description": "Qualitative confidence used by metrics, gates and decisions.",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "CounterEvidenceClaim": {
      "additionalProperties": false,
      "description": "A falsifying/counter claim whose evidence must be in the task packet.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "direction": {
          "const": "COUNTER",
          "default": "COUNTER",
          "title": "Direction",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "deterministic_metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Deterministic Metric Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "statement",
        "evidence_ids",
        "confidence"
      ],
      "title": "CounterEvidenceClaim",
      "type": "object"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "description": "A supporting claim whose evidence must be in the task packet.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "direction": {
          "const": "SUPPORT",
          "default": "SUPPORT",
          "title": "Direction",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "deterministic_metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Deterministic Metric Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "statement",
        "evidence_ids",
        "confidence"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "ProposedBy": {
      "description": "Actor that proposed an adjustment.",
      "enum": [
        "RULE_ENGINE",
        "LLM",
        "HUMAN"
      ],
      "title": "ProposedBy",
      "type": "string"
    },
    "ResearchFinding": {
      "additionalProperties": false,
      "description": "One analyst's structured, untrusted research finding.",
      "properties": {
        "contract": {
          "const": "research_finding_v1",
          "default": "research_finding_v1",
          "title": "Contract",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "analysis_id": {
          "minLength": 1,
          "title": "Analysis Id",
          "type": "string"
        },
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AnalystRole"
        },
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "dimension": {
          "anyOf": [
            {
              "enum": [
                "demand_durability",
                "cyclicality",
                "pricing_power",
                "moat",
                "capital_efficiency",
                "dependency",
                "regulatory_risk",
                "predictability"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension"
        },
        "summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "supporting_claims": {
          "items": {
            "$ref": "#/$defs/EvidenceClaim"
          },
          "maxItems": 64,
          "title": "Supporting Claims",
          "type": "array"
        },
        "counter_evidence_claims": {
          "items": {
            "$ref": "#/$defs/CounterEvidenceClaim"
          },
          "maxItems": 64,
          "title": "Counter Evidence Claims",
          "type": "array"
        },
        "proposed_score": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Score"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "deterministic_metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Deterministic Metric Ids",
          "type": "array"
        },
        "unresolved_questions": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Unresolved Questions",
          "type": "array"
        },
        "counter_evidence_checked": {
          "default": false,
          "title": "Counter Evidence Checked",
          "type": "boolean"
        },
        "proposed_adjustments": {
          "items": {
            "$ref": "#/$defs/Adjustment"
          },
          "maxItems": 32,
          "title": "Proposed Adjustments",
          "type": "array"
        }
      },
      "required": [
        "contract",
        "id",
        "analysis_id",
        "listing_id",
        "as_of",
        "role",
        "question_id",
        "summary",
        "confidence"
      ],
      "title": "ResearchFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Persisted output of one model-neutral analyst invocation.",
  "properties": {
    "contract": {
      "const": "analyst_run_v1",
      "default": "analyst_run_v1",
      "title": "Contract",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "listing_id": {
      "minLength": 1,
      "title": "Listing Id",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/AnalystRole"
    },
    "question_id": {
      "minLength": 1,
      "title": "Question Id",
      "type": "string"
    },
    "dimension": {
      "anyOf": [
        {
          "enum": [
            "demand_durability",
            "cyclicality",
            "pricing_power",
            "moat",
            "capital_efficiency",
            "dependency",
            "regulatory_risk",
            "predictability"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dimension"
    },
    "packet_id": {
      "minLength": 1,
      "title": "Packet Id",
      "type": "string"
    },
    "available_evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Available Evidence Ids",
      "type": "array"
    },
    "finding": {
      "$ref": "#/$defs/ResearchFinding"
    },
    "metadata": {
      "$ref": "#/$defs/AgentRunMetadata"
    },
    "status": {
      "$ref": "#/$defs/AnalystRunStatus",
      "default": "COMPLETED"
    },
    "protocol_version": {
      "default": "research-protocol-v1",
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "run_id",
    "task_id",
    "analysis_id",
    "listing_id",
    "as_of",
    "profile_id",
    "role",
    "question_id",
    "packet_id",
    "finding",
    "metadata",
    "input_sha256",
    "output_sha256"
  ],
  "title": "Turtle Value Engine analyst-run",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blooddrunk/turtle-value-engine/schemas/analyst-run.schema.json"
}
