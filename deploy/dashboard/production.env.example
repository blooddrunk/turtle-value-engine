# Non-secret M6-C2 deployment inputs. Copy values into an environment/secret
# manager on the deployment host; do not commit a populated copy.
CLOUDFLARE_ACCOUNT_ID=<32-character-account-id>
TVE_DASHBOARD_HOSTNAME=dashboard.example.com
TVE_DASHBOARD_ACCESS_EMAIL=owner@example.com
TVE_SURFACE_API_ORIGIN=https://surface.example.com
TVE_SURFACE_ORIGIN_HOSTNAME=surface.example.com
TVE_CLOUDFLARE_TUNNEL_ID=<existing-cloudflare-tunnel-uuid>
TVE_CLOUDFLARE_ZONE_ID=<zone-id-used-for-surface-cname>
TVE_SURFACE_PORT=8787
TVE_SURFACE_SNAPSHOT_PATH=/srv/turtle-value-engine/research-surface.json

# The following values are secret references, not values to put in this file.
# SURFACE_API_ACCESS_CLIENT_ID
# SURFACE_API_ACCESS_CLIENT_SECRET
# TVE_DASHBOARD_ACCESS_CLIENT_ID
# TVE_DASHBOARD_ACCESS_CLIENT_SECRET
# CLOUDFLARE_API_TOKEN
